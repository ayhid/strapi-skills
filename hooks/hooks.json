{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-strapi-server.sh\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-strapi-schema.sh\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-admin-tsx.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-strapi-context.sh\"" }
        ]
      }
    ]
  }
}
