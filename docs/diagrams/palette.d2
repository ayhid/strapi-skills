# Shared palette: saturated fills with white text, legible on light and dark pages.
classes: {
  blue: {style: {fill: "#2563EB"; stroke: "#1E40AF"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  violet: {style: {fill: "#7C3AED"; stroke: "#5B21B6"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  pink: {style: {fill: "#DB2777"; stroke: "#9D174D"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  orange: {style: {fill: "#EA580C"; stroke: "#9A3412"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  green: {style: {fill: "#16A34A"; stroke: "#166534"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  teal: {style: {fill: "#0D9488"; stroke: "#115E59"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  red: {style: {fill: "#DC2626"; stroke: "#991B1B"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  yellow: {style: {fill: "#FACC15"; stroke: "#A16207"; font-color: "#1F2937"; bold: true; stroke-width: 2}}
  slate: {style: {fill: "#475569"; stroke: "#1E293B"; font-color: "#FFFFFF"; bold: true; stroke-width: 2}}
  frame-blue: {style: {fill: transparent; stroke: "#2563EB"; stroke-width: 3; bold: true; font-color: "#2563EB"}}
  frame-green: {style: {fill: transparent; stroke: "#16A34A"; stroke-width: 3; bold: true; font-color: "#16A34A"}}
  arrow: {style: {stroke: "#7C3AED"; stroke-width: 3; font-color: "#7C3AED"; bold: true}}
}
